{
  "name": "@orkid-labs/plugin-mempalace",
  "description": "ElizaOS plugin for persistent agent memory via MemPalace MCP \u2014 verbatim store, search, and recall of agent context across sessions with local-first storage over stdio or HTTP/SSE",
  "version": "2.0.1",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageType": "plugin",
  "platform": "node",
  "license": "MIT",
  "author": "orkid-labs",
  "keywords": [
    "plugin",
    "elizaos",
    "eliza",
    "ai-agent",
    "agent-plugin",
    "mempalace",
    "memory",
    "agent-memory",
    "persistent-memory",
    "long-term-memory",
    "mcp",
    "mcp-server",
    "vector-search",
    "local-first",
    "recall",
    "context",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orkid-labs/plugin-mempalace.git"
  },
  "homepage": "https://github.com/orkid-labs/plugin-mempalace",
  "bugs": {
    "url": "https://github.com/orkid-labs/plugin-mempalace/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    ".npmignore",
    ".gitignore",
    "package.json"
  ],
  "dependencies": {
    "@elizaos/core": "2.0.3-beta.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^25.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "scripts": {
    "dev": "bun run build:watch",
    "build": "bun run build.ts",
    "lint": "biome check --write --unsafe ./src",
    "lint:check": "biome check ./src",
    "typecheck": "tsc --noEmit",
    "test:component": "vitest run src/__tests__",
    "test:e2e": "vitest run src/e2e",
    "test:e2e:manual": "bun run test:e2e",
    "test": "bun run test:component && bun run test:e2e",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "build:watch": "bun run build.ts --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "resolutions": {
    "zod": "^4.4.3"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "MEMPALACE_MCP_CMD": {
        "type": "string",
        "description": "Command to spawn MemPalace MCP server (stdio transport). Example: mempalace-server"
      },
      "MEMPALACE_MCP_URL": {
        "type": "string",
        "description": "URL of running MemPalace HTTP/SSE server. Takes precedence over MEMPALACE_MCP_CMD."
      },
      "MEMPALACE_DIR": {
        "type": "string",
        "description": "Data directory for MemPalace storage (optional)."
      }
    }
  },
  "npmPackage": "@orkid-labs/plugin-mempalace"
}
